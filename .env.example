# JustChess settings. Copy to .env (ignored by git) and adjust.
# A variable already set in your shell wins over this file.

# Web Push signing key. Keep the key itself OUTSIDE the repository; this only
# names the file. Create one with:
#   uv run python -m justchess.vapid generate ~/.config/justchess/vapid.pem
JUSTCHESS_VAPID_KEY_FILE=/home/you/.config/justchess/vapid.pem
# Contact address the push services may use (mailto: or https:).
# JUSTCHESS_VAPID_SUBJECT=mailto:you@example.com
# Extra push service hosts, comma-separated (the main browser vendors are built in).
# JUSTCHESS_PUSH_HOSTS=

# SQLite database file (default: justchess.sqlite3 in the project folder).
# JUSTCHESS_DB=justchess.sqlite3

# Optional PostgreSQL URL. A nonempty value takes precedence over JUSTCHESS_DB.
# The database must already exist; its role needs permission to create tables.
# An invalid/unreachable URL stops startup; it never silently falls back.
# DATABASE_URL=postgresql://user:password@localhost:5432/justchess

# Expected origin when the app runs behind a proxy, e.g. https://chess.example.com
# JUSTCHESS_ORIGIN=

# Reverse proxies on ANOTHER host whose X-Forwarded-For is trusted for the
# join-request rate limit: comma-separated IPs or CIDRs (default: none). A proxy
# on the same machine needs nothing here: Uvicorn's --forwarded-allow-ips handles it.
# JUSTCHESS_TRUSTED_PROXIES=

# Folder with the opening lesson files (default: lessons/).
# JUSTCHESS_LESSONS_DIR=lessons

# Folder with the curated tactics puzzles (default: puzzles/).
# JUSTCHESS_PUZZLES_DIR=puzzles

# Gameplay settings file: computer levels, limits, lifetimes (default: gameplay.yaml).
# JUSTCHESS_GAMEPLAY_FILE=gameplay.yaml

# Set to 0 to skip the Stockfish download at start-up.
# STOCKFISH_AUTO_INSTALL=1
